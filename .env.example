# Discord invite (defaults in lib/site.ts if unset)
NEXT_PUBLIC_DISCORD_INVITE=https://discord.gg/munhcFgfez

# Public site URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://kyrosps.io

# Stripe (Dashboard → Developers → API keys)
STRIPE_SECRET_KEY=sk_live_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
# Webhook signing secret for https://kyrosps.io/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=whsec_...

# Shared password for game server claim API (must match server.properties api_password)
STORE_API_PASSWORD=change-me-long-random

# VPS JSON store (hiscores + votes)
HISCORES_STORE_URL=http://74.50.97.159:8791

# RULOCUS vote callback secret (must match listing dashboard Callback Secret)
VOTE_CALLBACK_SECRET=generate-a-long-random-secret
# Optional: RSPS-List dashboard API secret (if different from VOTE_CALLBACK_SECRET)
RSPS_LIST_VOTE_SECRET=

# Top100Arena listing id (from https://www.top100arena.com/listing/XXXXX/vote)
# NEXT_PUBLIC_TOP100ARENA_LISTING_ID=12345
# Dashboard Incentive Postback (exact):
# https://kyrosps.io/api/vote/callback?postback=&site=top100arena

# Public vote listing (optional; links built in lib/votes.ts)
# NEXT_PUBLIC_VOTE_LISTING_URL=https://www.rulocus.com/top-rsps-list/kyros

# Optional: override Stripe price IDs per package
# STRIPE_PRICE_STARTER=price_...
# STRIPE_PRICE_BOOST=price_...
# STRIPE_PRICE_BUNDLE=price_...
# STRIPE_PRICE_SUPPORT=price_...
# STRIPE_PRICE_PATRON=price_...
