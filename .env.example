# Discord invite (defaults in lib/site.ts if unset)
NEXT_PUBLIC_DISCORD_INVITE=https://discord.gg/munhcFgfez

# Public site URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://kyrosps.io

# Stripe (Dashboard → Developers → API keys)
STRIPE_SECRET_KEY=sk_live_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
# Webhook signing secret for https://kyrosps.io/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=whsec_...

# Shared password for game server claim API (must match server.properties api_password)
STORE_API_PASSWORD=change-me-long-random

# Optional: override Stripe price IDs per package
# STRIPE_PRICE_STARTER=price_...
# STRIPE_PRICE_BOOST=price_...
# STRIPE_PRICE_BUNDLE=price_...
# STRIPE_PRICE_SUPPORT=price_...
# STRIPE_PRICE_PATRON=price_...
